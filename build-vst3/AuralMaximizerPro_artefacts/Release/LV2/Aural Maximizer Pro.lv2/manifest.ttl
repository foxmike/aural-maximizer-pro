@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pset:  <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<urn:nspace:aural-maximizer-pro>
	a lv2:Plugin ;
	lv2:binary <libAural%20Maximizer%20Pro.so> ;
	rdfs:seeAlso <dsp.ttl> .

<urn:nspace:aural-maximizer-pro:UI>
	a ui:X11UI ;
	lv2:binary <libAural%20Maximizer%20Pro.so> ;
	rdfs:seeAlso <ui.ttl> .

<urn:nspace:aural-maximizer-pro:preset1>
	a pset:Preset ;
	lv2:appliesTo <urn:nspace:aural-maximizer-pro> ;
	rdfs:label "" ;
	state:state [ <urn:nspace:aural-maximizer-pro:Program> "0"^^xsd:int ; ] .

