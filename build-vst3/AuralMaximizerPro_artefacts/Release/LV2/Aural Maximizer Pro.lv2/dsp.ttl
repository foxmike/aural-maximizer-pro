@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufs:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix plug:  <urn:nspace:aural-maximizer-pro:> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

plug:MAX_ENABLE
	a lv2:Parameter ;
	rdfs:label "Maximizer Enable" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1	 ;
	lv2:portProperty lv2:enumeration , lv2:toggled ;
	lv2:scalePoint [
		rdfs:label "Off" ;
		rdf:value 0 ;
	], [
		rdfs:label "On" ;
		rdf:value 1 ;
	] .

plug:MAX_PROCESS
	a lv2:Parameter ;
	rdfs:label "Maximizer Process" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:MAX_CONTOUR
	a lv2:Parameter ;
	rdfs:label "Maximizer Lo Contour" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:MAX_LOW_FREQ
	a lv2:Parameter ;
	rdfs:label "Maximizer Low Frequency" ;
	rdfs:range atom:Float ;
	lv2:default 120 ;
	lv2:minimum 40 ;
	lv2:maximum 400 .

plug:MAX_HIGH_FREQ
	a lv2:Parameter ;
	rdfs:label "Maximizer High Frequency" ;
	rdfs:range atom:Float ;
	lv2:default 5000 ;
	lv2:minimum 1000 ;
	lv2:maximum 12000 .

plug:MAX_PHASE_MODE
	a lv2:Parameter ;
	rdfs:label "Maximizer Phase Mode" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "Classic" ;
		rdf:value 0 ;
	], [
		rdfs:label "Modern" ;
		rdf:value 1 ;
	] .

plug:EXC_ENABLE
	a lv2:Parameter ;
	rdfs:label "Exciter Enable" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1	 ;
	lv2:portProperty lv2:enumeration , lv2:toggled ;
	lv2:scalePoint [
		rdfs:label "Off" ;
		rdf:value 0 ;
	], [
		rdfs:label "On" ;
		rdf:value 1 ;
	] .

plug:EXC_TUNE
	a lv2:Parameter ;
	rdfs:label "Exciter Tune" ;
	rdfs:range atom:Float ;
	lv2:default 3000 ;
	lv2:minimum 800 ;
	lv2:maximum 10000 .

plug:EXC_DRIVE
	a lv2:Parameter ;
	rdfs:label "Exciter Drive" ;
	rdfs:range atom:Float ;
	lv2:default 6 ;
	lv2:minimum 0 ;
	lv2:maximum 24 .

plug:EXC_MIX
	a lv2:Parameter ;
	rdfs:label "Exciter Mix" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:EXC_MODE
	a lv2:Parameter ;
	rdfs:label "Exciter Mode" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "Cubic Soft Clipping" ;
		rdf:value 0 ;
	], [
		rdfs:label "Asymmetric Tube" ;
		rdf:value 1 ;
	], [
		rdfs:label "Tape" ;
		rdf:value 2 ;
	] .

plug:EXC_HARMONICS
	a lv2:Parameter ;
	rdfs:label "Exciter Harmonics" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:EXC_AIR_GAIN
	a lv2:Parameter ;
	rdfs:label "Exciter Air Gain" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 12 .

plug:ROUTING_MODE
	a lv2:Parameter ;
	rdfs:label "Routing Mode" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 2	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "Maximizer -> Exciter" ;
		rdf:value 0 ;
	], [
		rdfs:label "Exciter -> Maximizer" ;
		rdf:value 1 ;
	], [
		rdfs:label "Parallel Matrix" ;
		rdf:value 2 ;
	] .

plug:PARALLEL_BLEND
	a lv2:Parameter ;
	rdfs:label "Parallel Blend" ;
	rdfs:range atom:Float ;
	lv2:default 0.5 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:MASTER_IN_GAIN
	a lv2:Parameter ;
	rdfs:label "Master Input Gain" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -24 ;
	lv2:maximum 24 .

plug:MASTER_OUT_GAIN
	a lv2:Parameter ;
	rdfs:label "Master Output Gain" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum -24 ;
	lv2:maximum 24 .

plug:MASTER_MIX
	a lv2:Parameter ;
	rdfs:label "Master Mix" ;
	rdfs:range atom:Float ;
	lv2:default 1 ;
	lv2:minimum 0 ;
	lv2:maximum 1 .

plug:OVERSAMPLING
	a lv2:Parameter ;
	rdfs:label "Oversampling" ;
	rdfs:range atom:Float ;
	lv2:default 0 ;
	lv2:minimum 0 ;
	lv2:maximum 1	 ;
	lv2:portProperty lv2:enumeration ;
	lv2:scalePoint [
		rdfs:label "2x" ;
		rdf:value 0 ;
	], [
		rdfs:label "4x" ;
		rdf:value 1 ;
	] .

plug:input_group_1
	a pg:InputGroup ;
	lv2:name "Input" ;
	lv2:symbol "input_group_1" .

plug:output_group_1
	a pg:OutputGroup ;
	lv2:name "Output" ;
	lv2:symbol "output_group_1" .

<urn:nspace:aural-maximizer-pro>
	ui:ui <urn:nspace:aural-maximizer-pro:UI> ;
	a lv2:Plugin ;
	doap:name "Aural Maximizer Pro" ;
	doap:description "Aural Maximizer Pro" ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "nSpace" ;
		foaf:homepage <> ;
		foaf:mbox <> ;
	] ;
	doap:release [
		a doap:Version ;
		doap:revision "0.1.0" ;
	] ;
	lv2:optionalFeature
		lv2:hardRTCapable ;
	lv2:extensionData
		state:interface ;
	lv2:requiredFeature
		urid:map ,
		opts:options ,
		bufs:boundedBlockLength ;
	pg:mainInput plug:input_group_1 ;
	pg:mainOutput plug:output_group_1 ;
	patch:writable
		plug:MAX_ENABLE ,
		plug:MAX_PROCESS ,
		plug:MAX_CONTOUR ,
		plug:MAX_LOW_FREQ ,
		plug:MAX_HIGH_FREQ ,
		plug:MAX_PHASE_MODE ,
		plug:EXC_ENABLE ,
		plug:EXC_TUNE ,
		plug:EXC_DRIVE ,
		plug:EXC_MIX ,
		plug:EXC_MODE ,
		plug:EXC_HARMONICS ,
		plug:EXC_AIR_GAIN ,
		plug:ROUTING_MODE ,
		plug:PARALLEL_BLEND ,
		plug:MASTER_IN_GAIN ,
		plug:MASTER_OUT_GAIN ,
		plug:MASTER_MIX ,
		plug:OVERSAMPLING ;
	patch:readable
		plug:MAX_ENABLE ,
		plug:MAX_PROCESS ,
		plug:MAX_CONTOUR ,
		plug:MAX_LOW_FREQ ,
		plug:MAX_HIGH_FREQ ,
		plug:MAX_PHASE_MODE ,
		plug:EXC_ENABLE ,
		plug:EXC_TUNE ,
		plug:EXC_DRIVE ,
		plug:EXC_MIX ,
		plug:EXC_MODE ,
		plug:EXC_HARMONICS ,
		plug:EXC_AIR_GAIN ,
		plug:ROUTING_MODE ,
		plug:PARALLEL_BLEND ,
		plug:MASTER_IN_GAIN ,
		plug:MASTER_OUT_GAIN ,
		plug:MASTER_MIX ,
		plug:OVERSAMPLING ;
	lv2:port [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 0 ;
		lv2:symbol "audio_in_1" ;
		lv2:name "Audio In 1" ;
		pg:group plug:input_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#left> ;
	] , [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "audio_in_2" ;
		lv2:name "Audio In 2" ;
		pg:group plug:input_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#right> ;
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "audio_out_1" ;
		lv2:name "Audio Out 1" ;
		pg:group plug:output_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#left> ;
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 3 ;
		lv2:symbol "audio_out_2" ;
		lv2:name "Audio Out 2" ;
		pg:group plug:output_group_1 ;
		lv2:designation <http://lv2plug.in/ns/ext/port-groups#right> ;
	] , [
		a lv2:InputPort , atom:AtomPort ;
		rsz:minimumSize 9560 ;
		atom:bufferType atom:Sequence ;
		atom:supports
			patch:Message ,
			time:Position ;
		lv2:designation lv2:control ;
		lv2:index 4 ;
		lv2:symbol "in" ;
		lv2:name "In" ;
	] , [
		a lv2:OutputPort , atom:AtomPort ;
		rsz:minimumSize 9560 ;
		atom:bufferType atom:Sequence ;
		atom:supports
			patch:Message ;
		lv2:designation lv2:control ;
		lv2:index 5 ;
		lv2:symbol "out" ;
		lv2:name "Out" ;
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:designation lv2:latency ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:index 6 ;
		lv2:portProperty lv2:reportsLatency , lv2:integer , lv2:connectionOptional , pprop:notOnGUI ;
		units:unit units:frame ;
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:designation lv2:freeWheeling ;
		lv2:symbol "freeWheeling" ;
		lv2:name "Free Wheeling" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
		lv2:index 7 ;
		lv2:portProperty lv2:toggled , lv2:connectionOptional , pprop:notOnGUI ;
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:designation lv2:enabled ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:default 1.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
		lv2:index 8 ;
		lv2:portProperty lv2:toggled , lv2:connectionOptional , pprop:notOnGUI ;
	] ;
	opts:supportedOption
		bufs:maxBlockLength .
