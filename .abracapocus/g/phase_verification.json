{
  "verification": {
    "checks": [
      {
        "name": "cmake_configure",
        "command": [
          "cmake",
          "-B",
          "cmake-build-debug",
          "-G",
          "Ninja"
        ]
      },
      {
        "name": "cmake_build_standalone",
        "command": [
          "cmake",
          "--build",
          "cmake-build-debug",
          "--target",
          "AuralMaximizerPro_Standalone"
        ]
      },
      {
        "name": "cppcheck_source",
        "command": [
          "cppcheck",
          "--enable=all",
          "Source/"
        ]
      },
      {
        "name": "clang_format_phase_g",
        "command": [
          "clang-format",
          "--dry-run",
          "--Werror",
          "Source/GUI/SpectrumVisualizer.h",
          "Source/GUI/SpectrumVisualizer.cpp",
          "Source/GUI/MeterComponent.h",
          "Source/GUI/MeterComponent.cpp"
        ]
      },
      {
        "name": "phase_g_verification_doc_exists",
        "command": [
          "test",
          "-f",
          "docs/verification/phase_g_gui_components.md"
        ]
      }
    ]
  }
}
